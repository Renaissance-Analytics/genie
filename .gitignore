node_modules/
dist/
out/
*.log
.DS_Store
dist/

# The smoke run writes one here for a human to look at. Regenerable, and a PNG in git is a
# PNG somebody will later diff.
smoke-*.png
installed-smoke-*.png
release/

# Throwaway diagnostics. They are written to answer one question and should not outlive it —
# a repo full of half-remembered probes is worse than none, because somebody runs one.
scripts/_*

# Scratch for one-off measurements. A probe that proved something belongs in a test or in a
# comment that cites it, never as a script nobody will run again.
sandbox/

# The smoke mirrors its result here so a long run cannot lose it to a caller timeout.
# Regenerable, and the run that matters is the next one.
smoke.txt
v1-installers/

# A row's staged files for the WSL batch's patch script (`.patch/patch-<row>.mjs` copies them into place inside the
# machine). Scratch: the ship step commits the placed files by path, never this directory.
.patch/

# genie-launch.exe, built from native/win-launcher by scripts/build-win-launcher.mjs (never checked in, #1628)
build/win-launcher/

# What scripts/ci/linux.sh and windows.ps1 write on a run: each row's log, the suite's times (Tynn #692)
ci-out/

# What scripts/ci/windows.ps1 reads for its rows when In-Session cannot pass them (Tynn #692)
ci-rows.txt
# The changed paths the CI caller writes before a run, read by scripts/ci/linux.sh (Tynn #692)
ci-changed.txt
