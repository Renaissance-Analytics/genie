{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // TYPECHECK ONLY. The main-process bundles are built by `scripts/build-main.mjs`
    // (Vite/rolldown), not by tsc — see `npm run build:main`.
    //
    // `outDir` used to be `../app` here, and that is a trap worth naming rather than
    // leaving for the next person to find: with `rootDir: '..'`, tsc mirrors the source
    // tree, so `tsc -p main/tsconfig.json` emits `app/main/background.js` while
    // `package.json#main` loads `app/background.js`. Nothing loads, and Electron's only
    // complaint is a bare "Cannot find module". That cost this branch four red CI jobs.
    // No `outDir` means no emit to get wrong.
    "noEmit": true,
    "module": "commonjs",
    "target": "ES2022",
    "jsx": "react-jsx",
    "paths": {
      "@main/*": ["../main/*"],
      "@renderer/*": ["../renderer/*"],
      "@particle-academy/fancy-term-host/service": [
        "../node_modules/@particle-academy/fancy-term-host/dist/service.d.ts"
      ],
      "@particle-academy/fancy-flow/engine": [
        "../node_modules/@particle-academy/fancy-flow/dist/engine.d.ts"
      ]
    }
  },
  "include": ["./**/*"]
}
