  "treeCases": [
    { "name": "every file, nothing else", "listed": [["a.txt", "alpha"], ["sub/b.txt", "beta"]], "tree": [["a.txt", "alpha"], ["sub/b.txt", "beta"]], "verdict": { "ok": true } },
