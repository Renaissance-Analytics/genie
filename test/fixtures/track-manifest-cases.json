    { "name": "notes that are not text", "edit": [["\"notes\":\"a fixture\"", "\"notes\":1"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "another track than the one asked for", "expect": { "track": "client" }, "verdict": { "ok": false, "code": "track" } },
    { "name": "another platform", "expect": { "platform": "win32" }, "verdict": { "ok": false, "code": "platform" } },
    { "name": "another architecture", "expect": { "arch": "arm64" }, "verdict": { "ok": false, "code": "arch" } },
    { "name": "a dev build on a stable install", "edit": [["\"channel\":\"stable\"", "\"channel\":\"dev\""]], "verdict": { "ok": false, "code": "channel" } },
    { "name": "a dev build on a dev install", "edit": [["\"channel\":\"stable\"", "\"channel\":\"dev\""]], "expect": { "channel": "dev" }, "verdict": { "ok": true } },
    { "name": "a stable build on a dev install", "expect": { "channel": "dev" }, "verdict": { "ok": true } },
