    { "name": "the build's age is checked before minLauncher", "edit": [["\"minLauncher\":null", "\"minLauncher\":\"2026.12.01-1\""]], "expect": { "current": "2026.11.25-1", "launcher": "2026.11.25-1" }, "verdict": { "ok": false, "code": "downgrade" } },
