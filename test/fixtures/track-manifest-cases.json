{
  "format": 2,
  "about": "THE SHARED VERIFY-BEFORE-RUN TABLE (Tynn #1058 L2; format 2 since L3). src/core/track-manifest.ts (test/track-manifest-table.test.ts) and the Rust launcher (native/launcher/tests/manifest_table.rs) read this one file and must reach the same verdict on every case: verifyManifest's for manifestCases, verifyTree's for treeCases. The two seeds are THROWAWAY TEST KEYS, published here on purpose: no release build trusts them (the launcher reads a test key only under its test-keys feature). Ed25519 is deterministic, so both languages make the same signature from a seed. A manifest case: its text is `manifest` (default `base`) with each `edit` [from, to] applied to the first occurrence of `from`; those UTF-8 bytes are signed by `signer` (default a), then each `tamper` edit is applied to what is delivered. The signature file is `sigPrefix` + the signature + `sigSuffix`, or `sig` as given; `sigMode: noncanonical` sets the low bit of the last data character (padding bits the canonical form leaves zero). `keys` are the trusted keys (default [a]); `expect` overrides `expectDefault`. A tree case: the manifest lists `listed` (path, UTF-8 text); the folder holds `tree` plus the empty folders `dirs`.",
  "seeds": {
    "a": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
    "b": "202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f"
  },
  "base": "{\"format\":2,\"track\":\"host\",\"build\":\"2026.11.25-1\",\"schema\":\"2026.11.25\",\"channel\":\"stable\",\"platform\":\"linux\",\"arch\":\"x64\",\"withClient\":\"2026.11.25-1\",\"minLauncher\":null,\"files\":[{\"path\":\"app/host.js\",\"size\":6,\"sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"},{\"path\":\"genie-host\",\"size\":12,\"sha256\":\"2222222222222222222222222222222222222222222222222222222222222222\"}],\"notes\":\"a fixture\"}",
  "expectDefault": { "track": "host", "platform": "linux", "arch": "x64", "channel": "stable", "current": null, "launcher": null },
  "manifestCases": [
    { "name": "a good manifest", "verdict": { "ok": true } },
    { "name": "the signature file may end in ASCII whitespace", "sigSuffix": "\r\n \t", "verdict": { "ok": true } },
    { "name": "the signature file may not start with a space", "sigPrefix": " ", "verdict": { "ok": false, "code": "signature" } },
    { "name": "signed by a key not trusted", "signer": "b", "verdict": { "ok": false, "code": "signature" } },
    { "name": "any trusted key may have signed it", "keys": ["b", "a"], "verdict": { "ok": true } },
    { "name": "no trusted key", "keys": [], "verdict": { "ok": false, "code": "signature" } },
    { "name": "one byte changed after signing", "tamper": [["a fixture", "a fixturE"]], "verdict": { "ok": false, "code": "signature" } },
    { "name": "a signature that is not base64 of 64 bytes", "sig": "not a signature", "verdict": { "ok": false, "code": "signature" } },
    { "name": "a signature in a non-canonical base64 spelling", "sigMode": "noncanonical", "verdict": { "ok": false, "code": "signature" } },
    { "name": "a byte-order mark", "edit": [["{\"format\"", "﻿{\"format\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "not JSON", "manifest": "not json", "verdict": { "ok": false, "code": "format" } },
    { "name": "an unknown field", "edit": [["\"notes\":", "\"extra\":1,\"notes\":"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "format 1 (never published: L3 added withClient and the browser track)", "edit": [["\"format\":2,", "\"format\":1,"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "format written 2.0 is format 2", "edit": [["\"format\":2,", "\"format\":2.0,"]], "verdict": { "ok": true } },
    { "name": "format as a string", "edit": [["\"format\":2,", "\"format\":\"2\","]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a size written 6.0", "edit": [["\"size\":6,", "\"size\":6.0,"]], "verdict": { "ok": true } },
    { "name": "a size written 6e0", "edit": [["\"size\":6,", "\"size\":6e0,"]], "verdict": { "ok": true } },
    { "name": "a negative size", "edit": [["\"size\":6,", "\"size\":-1,"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a fractional size", "edit": [["\"size\":6,", "\"size\":6.5,"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "the largest safe size", "edit": [["\"size\":6,", "\"size\":9007199254740991,"]], "verdict": { "ok": true } },
    { "name": "a size past the safe integers", "edit": [["\"size\":6,", "\"size\":9007199254740992,"]], "verdict": { "ok": false, "code": "format" } },
    { "name": "an unknown track (a GApp track joins in a later format)", "edit": [["\"track\":\"host\"", "\"track\":\"gapp\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a build with no release", "edit": [["\"build\":\"2026.11.25-1\"", "\"build\":\"2026.11.25\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a build that is not a date", "edit": [["\"build\":\"2026.11.25-1\",\"schema\":\"2026.11.25\"", "\"build\":\"2026.02.30-1\",\"schema\":\"2026.02.30\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a build with +metadata", "edit": [["\"build\":\"2026.11.25-1\"", "\"build\":\"2026.11.25-1+abc\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a schema that is not the build's", "edit": [["\"schema\":\"2026.11.25\"", "\"schema\":\"2026.11.24\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "an unknown channel", "edit": [["\"channel\":\"stable\"", "\"channel\":\"beta\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "an unknown platform", "edit": [["\"platform\":\"linux\"", "\"platform\":\"darwin\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a minLauncher that is not a build", "edit": [["\"minLauncher\":null", "\"minLauncher\":\"soon\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "no minLauncher field", "edit": [["\"minLauncher\":null,", ""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "no files", "edit": [["{\"path\":\"app/host.js\",\"size\":6,\"sha256\":\"1111111111111111111111111111111111111111111111111111111111111111\"},{\"path\":\"genie-host\",\"size\":12,\"sha256\":\"2222222222222222222222222222222222222222222222222222222222222222\"}", ""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "files out of byte order", "edit": [["\"app/host.js\"", "\"zzz/host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "the same path twice", "edit": [["\"genie-host\"", "\"app/host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "two paths equal but for ASCII case", "edit": [["\"app/host.js\"", "\"Genie-host\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "two paths equal but for a non-ASCII letter's case", "edit": [["\"app/host.js\"", "\"É.txt\""], ["\"genie-host\"", "\"é.txt\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a .. segment", "edit": [["\"app/host.js\"", "\"../host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a . segment", "edit": [["\"app/host.js\"", "\"./host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "an absolute path", "edit": [["\"app/host.js\"", "\"/host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "an empty segment", "edit": [["\"app/host.js\"", "\"app//host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a backslash", "edit": [["\"app/host.js\"", "\"app\\\\host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a colon", "edit": [["\"app/host.js\"", "\"c:host.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a C0 control character", "edit": [["\"app/host.js\"", "\"app/\\u0001.js\""]], "verdict": { "ok": false, "code": "format" } },
    { "name": "a C1 control character", "edit": [["\"app/host.js\"", "\"app/\\u0085.js\""]], "verdict": { "ok": false, "code": "format" } },
