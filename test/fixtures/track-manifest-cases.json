    { "name": "the launcher minLauncher names", "edit": [["\"minLauncher\":null", "\"minLauncher\":\"2026.11.25-1\""]], "expect": { "launcher": "2026.11.25-1" }, "verdict": { "ok": true } },
    { "name": "minLauncher when the reader is not the launcher", "edit": [["\"minLauncher\":null", "\"minLauncher\":\"2026.12.01-1\""]], "verdict": { "ok": true } },
