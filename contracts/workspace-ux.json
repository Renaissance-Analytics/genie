{
  "$id": "https://raw.githubusercontent.com/Civicognita/shared-schemas/workspace-ux/v0.6.0/contracts/workspace-ux/0.6.0/workspace-ux.json",
  "contract": "workspace-ux",
  "version": "0.6.0",
  "about": "The workspace UX tynn.ai and Genie both offer, surface by surface: what a person can DO there, what STATES they see, and the API each action uses. tynn.ai, Genie and genie-cloud each declare against it, and each repo's checks fail when its code and this file disagree. Canonical in Civicognita/shared-schemas, published under the tag workspace-ux/v0.6.0 and never rewritten (genie#1295). Each consumer carries a byte-identical copy beside a pin that records the tag and the sha256 of these bytes.",
  "placeholders": {
    "{P}": "the web project prefix: /u/{user}/{project} or /o/{organization}/{project}",
    "{projectId}": "the Tynn project's id (the workspace's project.json tynn.projectId)"
  },
  "api": {
    "base": "/api/v1/projects/{projectId}",
    "credential": "the Genie pairing token (gpk_), never an agent's MCP key",
    "scope": "genie:board",
    "refusal": "404 for every refusal (no scope, no access, wrong project, role may not write)",
    "invalid": "422 naming why: errors.status for a workflow step, errors.claim for a claim or an assignment the project's claim rules refuse, or the field's own key for a body that does not validate"
  },
  "surfaces": [
    {
      "id": "board",
      "title": "Board",
      "tynn": { "page": "v2/Project/Kanban", "route": "board", "pageAccess": "work" },
      "data": {
        "api": { "method": "GET", "path": "/board" },
        "query": ["version", "story", "level", "features[]", "product"],
        "levels": {
          "versions": { "scope": "none", "columns": ["draft", "accepted", "active", "review"] },
          "stories": { "scope": "version", "columns": ["backlog", "blocked", "in_progress", "qa", "done"] },
          "tasks": { "scope": "story", "columns": ["backlog", "blocked", "doing", "qa", "done"] }
        },
        "fields": {
          "version": ["id", "number", "title", "status", "story_count", "stories_done", "task_count", "tasks_done"],
          "story": ["id", "story_number", "title", "status", "order", "task_count", "tasks_done", "claimed_by", "claimed_by_me", "can_start", "can_move_to_qa", "version_active"],
          "task": ["id", "task_number", "title", "status", "order", "story_id", "claimed_by", "claimed_by_me", "can_start", "version_active"]
        },
        "claims": {
          "field": "claims",
          "keys": ["mode", "policy", "can_assign"],
          "modes": ["off", "optional", "required"],
          "policies": ["any", "human", "agent"],
          "start": { "off": "start", "optional": "choose", "required": "claim-then-start", "mine": "start" },
          "release": "claimed_by_me",
          "assign": "can_assign"
        },
        "drag": { "versions": false, "stories": true, "tasks": true, "override": "shift" },
        "transitions": {
          "story": {
            "backlog": ["in_progress", "blocked"],
            "in_progress": ["qa", "blocked", "backlog"],
            "qa": ["done", "in_progress", "blocked", "backlog"],
            "blocked": ["backlog", "in_progress", "qa", "archived"],
            "done": ["archived", "in_progress", "backlog"],
            "archived": []
          },
          "task": {
            "backlog": ["doing", "blocked"],
            "doing": ["qa", "blocked", "backlog"],
            "qa": ["done", "doing", "blocked", "backlog"],
            "blocked": ["backlog", "doing", "qa", "archived"],
            "done": ["archived", "doing", "backlog"],
            "archived": []
          }
        },
        "quickActions": {
          "version": {
            "draft": { "verb": "accept" },
            "accepted": { "verb": "start" },
            "active": { "verb": "review" },
            "review": { "verb": "release" },
            "vip": { "verb": "release" },
            "rejected": { "verb": "restart" }
          },
          "story": {
            "backlog": { "verb": "start", "guard": "can_start" },
            "in_progress": { "verb": "ready", "guard": "can_move_to_qa" },
            "qa": { "verb": "done" },
            "blocked": { "verb": "restart" }
          },
          "task": {
            "backlog": { "verb": "start", "guard": "can_start" },
            "doing": { "verb": "ready", "guard": "version_active" },
            "qa": { "verb": "done", "guard": "version_active" },
            "blocked": { "verb": "restart" }
          }
        },
        "live": {
          "about": "The board follows Tynn as it changes, by a person or an agent, on the board's own channel and the web board's own events. An event is a doorbell: the client asks what changed since its cursor and applies only that, never re-reading the whole board.",
          "channel": "private-project-board.{projectId}",
          "web": "routes/channels.php project-board.{projectId}: exactly whoever may open the board (page work); the board's events ring there and on project.{projectId}, the channel every project page goes live on (whoever may open any page). The app is signed for the board's channel only, through auth below",
          "push": { "method": "GET", "path": "/api/v1/broadcasting-config", "scope": "genie:discovery" },
          "auth": { "method": "POST", "path": "/broadcasting-auth", "body": ["socket_id", "channel_name"] },
          "events": [
            "version.created", "version.updated", "version.deleted",
            "story.created", "story.updated", "story.deleted",
            "task.created", "task.updated", "task.deleted"
          ],
          "cursor": "cursor",
          "changes": {
            "method": "GET",
            "path": "/board/changes",
            "query": ["since", "ids[]", "version", "story", "level", "features[]", "product"],
            "answer": ["project_id", "level", "version_id", "story_id", "cursor", "ids", "rows", "active_version", "active_story", "claims"]
          },
          "reconnect": "backoff; on every (re)subscription the client asks for the changes since its last cursor before it shows live"
        }
      },
      "states": [
        { "id": "loading", "what": "the board is being read" },
        { "id": "empty-column", "what": "a column with no cards says so" },
        { "id": "drill-down", "what": "a version opens its stories, a story its tasks, and the person can go back up a level" },
        { "id": "illegal-drop", "what": "a drop onto a column the card cannot reach does not move it" },
        { "id": "override-armed", "what": "holding Shift while dragging lets the person drop anywhere" },
        { "id": "transition-refused", "what": "a refused step shows the reason the state machine gave" },
        { "id": "detail", "what": "a story or task opens its detail (description, acceptance criteria, tasks, features) and the person can edit it there" },
        { "id": "create-in-backlog", "what": "a new story or task is made in its level's backlog column; the workflow moves it on" },
        { "id": "claim-start", "what": "a backlog card's Start follows the project's claim mode: off (or already the person's) starts; optional offers Claim + Start or Start; required claims, then starts" },
        { "id": "claimed", "what": "a claimed card shows its claimant (a person's initials, or an agent's mark) and its name on hover; the person who holds the claim can release it" },
        { "id": "assign", "what": "a person who may manage the project picks a claimant from the project's eligible list (members and agents, by its claimant policy) and the card is assigned to them" },
        { "id": "live", "what": "the board follows Tynn as it changes, by a person or an agent, without a reload; a small live icon says so" },
        { "id": "reconnecting", "what": "the link to Tynn dropped: an icon says it is reconnecting, it retries with backoff, and it catches up from its cursor before it shows live again" },
        { "id": "not-linked", "what": "the workspace has no Tynn project" },
        { "id": "signed-out", "what": "Genie is not paired with Tynn, or the pairing lacks the board scope" }
      ],
      "actions": [
        { "id": "version.accept", "web": "POST versions.accept", "api": { "method": "POST", "path": "/versions/{versionId}/accept" }, "to": "accepted" },
        { "id": "version.start", "web": "POST versions.start", "api": { "method": "POST", "path": "/versions/{versionId}/start" }, "to": "active" },
        { "id": "version.review", "web": "POST versions.review", "api": { "method": "POST", "path": "/versions/{versionId}/review" }, "to": "review" },
        { "id": "version.release", "web": "POST versions.release", "api": { "method": "POST", "path": "/versions/{versionId}/release" }, "to": "released" },
        { "id": "version.restart", "web": "POST versions.restart", "api": { "method": "POST", "path": "/versions/{versionId}/restart" }, "to": "draft" },
        { "id": "version.delete", "web": "DELETE versions.destroy", "api": { "method": "DELETE", "path": "/versions/{versionId}" } },
        { "id": "version.create", "web": "POST versions.store", "api": null },
        { "id": "version.edit", "web": "PATCH versions.update", "api": null },

        { "id": "story.start", "web": "POST stories.start", "api": { "method": "POST", "path": "/stories/{storyId}/start" }, "to": "in_progress" },
        { "id": "story.ready", "web": "POST stories.ready", "api": { "method": "POST", "path": "/stories/{storyId}/ready" }, "to": "qa" },
        { "id": "story.done", "web": "POST stories.done", "api": { "method": "POST", "path": "/stories/{storyId}/done" }, "to": "done" },
        { "id": "story.restart", "web": "POST stories.restart", "api": { "method": "POST", "path": "/stories/{storyId}/restart" }, "to": "backlog" },
        { "id": "story.block", "web": "POST stories.block", "api": { "method": "POST", "path": "/stories/{storyId}/block" }, "to": "blocked" },
        { "id": "story.move", "web": "POST stories.move", "api": { "method": "POST", "path": "/stories/{storyId}/move" } },
        { "id": "story.delete", "web": "DELETE stories.destroy", "api": { "method": "DELETE", "path": "/stories/{storyId}" } },
        { "id": "story.create", "web": "POST stories.store", "api": { "method": "POST", "path": "/stories" } },
        { "id": "story.edit", "web": "PATCH stories.update", "api": { "method": "PATCH", "path": "/stories/{storyId}" } },
        { "id": "story.detail", "web": "GET board", "api": { "method": "GET", "path": "/stories/{storyId}" } },
        { "id": "story.claim", "web": "POST stories.claim", "api": { "method": "POST", "path": "/stories/{storyId}/claim" } },
        { "id": "story.unclaim", "web": "POST stories.release", "api": { "method": "POST", "path": "/stories/{storyId}/release" } },
        { "id": "story.assign", "web": "POST stories.assign", "api": { "method": "POST", "path": "/stories/{storyId}/assign" } },

        { "id": "task.start", "web": "POST tasks.start", "api": { "method": "POST", "path": "/tasks/{taskId}/start" }, "to": "doing" },
        { "id": "task.ready", "web": "POST tasks.ready", "api": { "method": "POST", "path": "/tasks/{taskId}/ready" }, "to": "qa" },
        { "id": "task.done", "web": "POST tasks.done", "api": { "method": "POST", "path": "/tasks/{taskId}/done" }, "to": "done" },
        { "id": "task.restart", "web": "POST tasks.restart", "api": { "method": "POST", "path": "/tasks/{taskId}/restart" }, "to": "backlog" },
        { "id": "task.block", "web": "POST tasks.block", "api": { "method": "POST", "path": "/tasks/{taskId}/block" }, "to": "blocked" },
        { "id": "task.move", "web": "POST tasks.move", "api": { "method": "POST", "path": "/tasks/{taskId}/move" } },
        { "id": "task.delete", "web": "DELETE tasks.destroy", "api": { "method": "DELETE", "path": "/tasks/{taskId}" } },
        { "id": "task.create", "web": "POST tasks.store", "api": { "method": "POST", "path": "/tasks" } },
        { "id": "task.edit", "web": "PATCH tasks.update", "api": { "method": "PATCH", "path": "/tasks/{taskId}" } },
        { "id": "task.detail", "web": "GET board", "api": { "method": "GET", "path": "/tasks/{taskId}" } },
        { "id": "task.claim", "web": "POST tasks.claim", "api": { "method": "POST", "path": "/tasks/{taskId}/claim" } },
        { "id": "task.unclaim", "web": "POST tasks.release", "api": { "method": "POST", "path": "/tasks/{taskId}/release" } },
        { "id": "task.assign", "web": "POST tasks.assign", "api": { "method": "POST", "path": "/tasks/{taskId}/assign" } },

        { "id": "board.claimants", "web": "GET claimants", "api": { "method": "GET", "path": "/claimants" } }
      ]
    },
    {
      "id": "wip",
      "title": "WIP",
      "tynn": { "page": "v2/Project/Wip", "route": "wip", "pageAccess": "wip" },
      "data": {
        "api": { "method": "GET", "path": "/wip" },
        "query": ["view", "story", "product"],
        "lenses": {
          "active": ["in_progress", "backlog"],
          "attention": ["blocked", "qa"],
          "done": ["done"]
        },
        "selection": "story: the story whose slug ?story= names, else the lens's first story; its tasks are shown",
        "answer": ["project_id", "view", "active_version", "available_versions", "stories", "selected_story", "tasks", "story_counts"],
        "counts": ["active", "attention", "done", "backlog"],
        "fields": {
          "story": ["id", "slug", "story_number", "title", "status", "description", "task_count", "tasks_done"],
          "task": ["id", "task_number", "title", "status", "claimed_by", "claimed_by_me", "can_start", "version_active", "features"]
        },
        "taskOrder": ["doing", "qa", "blocked", "backlog", "done"],
        "quickActions": {
          "task": {
            "backlog": { "verb": "start", "guard": "can_start" },
            "doing": { "verb": "ready", "guard": "version_active" },
            "qa": { "verb": "done", "guard": "version_active" },
            "blocked": { "verb": "restart" }
          }
        },
        "live": {
          "about": "The WIP page follows Tynn as the version's stories and tasks change. An event is a doorbell: the client reads the WIP page again, once per burst and one read at a time, as tynn.ai's page reloads its props.",
          "channel": "private-project-board.{projectId}",
          "web": "tynn.ai's WIP page goes live on project.{projectId} (ProjectShell → useProjectChannel), where the board's events also ring. The app hears them on the board's own channel, signed at the board door (board.data.live.auth) for whoever may open the board; a person with the WIP page but not the board (a client) is not signed for it, and the tab's WIP is then not live",
          "events": [
            "version.created", "version.updated", "version.deleted",
            "story.created", "story.updated", "story.deleted",
            "task.created", "task.updated", "task.deleted"
          ],
          "refresh": "read"
        }
      },
      "states": [
        { "id": "loading", "what": "WIP is being read" },
        { "id": "no-active-version", "what": "there is no active version, and WIP says so" },
        { "id": "lens", "what": "Active, Attention and Done lenses, each with its count; the person switches between them" },
        { "id": "empty-lens", "what": "a lens with no stories says so (Attention: nothing needs attention)" },
        { "id": "story-selected", "what": "the chosen story's title, description and its tasks, the ones in motion first, with how many are done" },
        { "id": "no-tasks", "what": "a story with no tasks says so" },
        { "id": "done-summary", "what": "the Done lens lists the stories delivered in the version, with their task counts" },
        { "id": "claim-start", "what": "a backlog task's Start follows the project's claim mode, as on the board" },
        { "id": "claimed", "what": "a claimed task shows its claimant" },
        { "id": "transition-refused", "what": "a refused step shows the reason the state machine gave" },
        { "id": "live", "what": "WIP follows Tynn as it changes, without a reload; a small live icon says so" },
        { "id": "reconnecting", "what": "the link to Tynn dropped: an icon says it is reconnecting, and WIP is read again once it is back" },
        { "id": "not-linked", "what": "the workspace has no Tynn project" },
        { "id": "signed-out", "what": "Genie is not paired with Tynn, or the pairing lacks the board scope" }
      ],
      "actions": [
        { "id": "task.start", "web": "POST tasks.start", "api": { "method": "POST", "path": "/tasks/{taskId}/start" }, "to": "doing" },
        { "id": "task.ready", "web": "POST tasks.ready", "api": { "method": "POST", "path": "/tasks/{taskId}/ready" }, "to": "qa" },
        { "id": "task.done", "web": "POST tasks.done", "api": { "method": "POST", "path": "/tasks/{taskId}/done" }, "to": "done" },
        { "id": "task.restart", "web": "POST tasks.restart", "api": { "method": "POST", "path": "/tasks/{taskId}/restart" }, "to": "backlog" },
        { "id": "task.claim", "web": "POST tasks.claim", "api": { "method": "POST", "path": "/tasks/{taskId}/claim" } }
      ]
    }
  ]
}
