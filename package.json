{
  "name": "genie",
  "version": "0.7.0-beta.285",
  "description": "Tynn desktop companion — tray-resident workspace manager",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "build:runtime": "node scripts/build-service-runtime.mjs",
    "build": "npm run build:runtime && nextron build",
    "build:win": "npm run build:runtime && nextron build --win",
    "build:mac": "npm run build:runtime && nextron build --mac",
    "postinstall": "node scripts/postinstall.mjs",
    "check:gapp": "vite-node main/apps/check-cli-run.ts --",
    "typecheck:main": "tsc --noEmit -p main/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p renderer/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "pretest": "npm rebuild better-sqlite3 || echo \"better-sqlite3 rebuild skipped — db tests may fail if the native ABI doesn't match the test runtime\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:hosting": "vitest run --config vitest.hosting.config.ts",
    "build:e2e": "nextron build --no-pack",
    "pretest:e2e": "node scripts/electron-rebuild-e2e.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:icons": "node resources/build-icons.cjs"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "serialize-javascript": "^7.0.6",
    "webpack": "^5.105.0",
    "sharp": "^0.35.0",
    "postcss": "$postcss",
    "@particle-academy/fancy-slides": {
      "@particle-academy/fancy-code": "$@particle-academy/fancy-code"
    },
    "fast-uri": "^3.1.5",
    "tar": "^7.5.22",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@2": "^2.1.4",
    "brace-expansion@5": "^5.0.9",
    "@electron/get": {
      "undici": "^7.29.0"
    },
    "node-gyp": {
      "undici": "^6.28.0"
    }
  },
  "dependencies": {
    "@particle-academy/dark-slide": "^0.5.2",
    "@particle-academy/fancy-artboard": "^0.5.0",
    "@particle-academy/fancy-brand-icons": "^0.2.0",
    "@particle-academy/fancy-code": "^0.9.0",
    "@particle-academy/fancy-features": "^0.1.1",
    "@particle-academy/fancy-file-commons": "^0.3.0",
    "@particle-academy/fancy-flow": "^0.48.0",
    "@particle-academy/fancy-git": "^0.3.0",
    "@particle-academy/fancy-git-ui": "^0.5.0",
    "@particle-academy/fancy-sheets": "^0.9.0",
    "@particle-academy/fancy-slides": "^0.15.2",
    "@particle-academy/fancy-term": "^0.4.1",
    "@particle-academy/fancy-term-host": "^0.3.1",
    "@particle-academy/holy-sheet": "^1.0.0",
    "@particle-academy/last-word": "^0.2.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "echarts-gl": "^2.1.0",
    "electron-updater": "^6.3.9",
    "libsodium-wrappers": "^0.8.4",
    "node-forge": "^1.4.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.27.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@particle-academy/react-fancy": "^4.16.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "next": "^15.5.21",
    "nextron": "^9.4.0",
    "postcss": "^8.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
