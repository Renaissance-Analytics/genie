{
  "name": "genie",
  "version": "2.0.0-beta.59",
  "private": true,
  "type": "module",
  "description": "Genie 2 — an agent is a session, never a terminal.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-win-launcher.mjs && vite build -c vite.main.config.ts",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:live": "tsx test/live/claude-session.live.ts",
    "verify:flow": "tsx test/live/agent-flow.live.ts",
    "verify:resume": "tsx test/live/resume.live.ts",
    "verify:terminal": "tsx test/live/terminal.live.ts",
    "verify:leak": "tsx test/live/terminal-leak.live.ts",
    "verify:flows": "vitest run -c vitest.flows.config.mts",
    "verify:zip64": "vitest run -c vitest.zip64.config.mts",
    "verify:app-inbox": "tsx test/live/app-inbox.live.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@particle-academy/agent-integrations": "0.47.1",
    "@particle-academy/dark-slide": "0.19.0",
    "@particle-academy/fancy-brand-icons": "0.4.0",
    "@particle-academy/fancy-code": "0.15.1",
    "@particle-academy/fancy-diff": "^0.5.1",
    "@particle-academy/fancy-file-commons": "^0.3.0",
    "@particle-academy/fancy-flow": "^0.81.0",
    "@particle-academy/fancy-git": "0.3.3",
    "@particle-academy/fancy-git-ui": "0.5.0",
    "@particle-academy/fancy-sheets": "0.13.1",
    "@particle-academy/fancy-slides": "0.25.1",
    "@particle-academy/fancy-term": "^0.8.0",
    "@particle-academy/fancy-term-host": "0.12.0",
    "@particle-academy/fancy-ws": "0.1.1",
    "@particle-academy/holy-sheet": "2.13.0",
    "@particle-academy/last-word": "0.10.0",
    "@particle-academy/prism-acp": "0.37.0",
    "@particle-academy/prism-harness": "0.8.0",
    "@particle-academy/prism-mcp": "^0.3.0",
    "@particle-academy/prism-mcp-server": "0.5.0",
    "@particle-academy/react-fancy": "6.7.2",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.1",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.5.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "main": "dist/main/entry.js"
}
