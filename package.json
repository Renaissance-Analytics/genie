{
  "name": "genie",
  "version": "2.0.0-beta.47",
  "private": true,
  "type": "module",
  "description": "Genie 2 — an agent is a session, never a terminal.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "vite build -c vite.main.config.ts",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:live": "tsx test/live/claude-session.live.ts",
    "verify:flow": "tsx test/live/agent-flow.live.ts",
    "verify:resume": "tsx test/live/resume.live.ts",
    "verify:terminal": "tsx test/live/terminal.live.ts",
    "verify:leak": "tsx test/live/terminal-leak.live.ts"
  },
  "dependencies": {
    "@particle-academy/agent-integrations": "0.47.1",
    "@particle-academy/dark-slide": "0.19.0",
    "@particle-academy/fancy-code": "0.15.0",
    "@particle-academy/fancy-diff": "^0.5.1",
    "@particle-academy/fancy-file-commons": "^0.3.0",
    "@particle-academy/fancy-flow": "^0.81.0",
    "@particle-academy/fancy-git": "0.3.1",
    "@particle-academy/fancy-git-ui": "0.5.0",
    "@particle-academy/fancy-sheets": "0.12.0",
    "@particle-academy/fancy-slides": "0.22.0",
    "@particle-academy/fancy-term": "^0.8.0",
    "@particle-academy/fancy-term-host": "0.11.1",
    "@particle-academy/fancy-ws": "0.1.1",
    "@particle-academy/holy-sheet": "2.10.1",
    "@particle-academy/last-word": "0.10.0",
    "@particle-academy/prism-acp": "0.27.0",
    "@particle-academy/prism-harness": "0.7.0",
    "@particle-academy/prism-mcp": "^0.3.0",
    "@particle-academy/prism-mcp-server": "0.3.1",
    "@particle-academy/react-fancy": "5.59.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "main": "dist/main/entry.js"
}
