{
    "name": "genie",
    "version": "0.7.0-beta.329",
    "description": "Tynn desktop companion — tray-resident workspace manager",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "main": "app/background.js",
    "scripts": {
        "dev": "nextron",
        "build:runtime": "node scripts/build-service-runtime.mjs",
        "build": "npm run build:runtime && nextron build",
        "build:win": "npm run build:runtime && nextron build --win",
        "build:mac": "npm run build:runtime && nextron build --mac",
        "postinstall": "node scripts/postinstall.mjs",
        "check:gapp": "vite-node main/apps/check-cli-run.ts --",
        "typecheck:main": "node node_modules/typescript/bin/tsc --noEmit -p main/tsconfig.json",
        "typecheck:renderer": "node node_modules/typescript/bin/tsc --noEmit -p renderer/tsconfig.json",
        "typecheck:e2e": "node node_modules/typescript/bin/tsc --noEmit -p e2e/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:hosting": "vitest run --config vitest.hosting.config.mts",
        "test:contract": "vitest run --config vitest.contract.config.mts",
        "build:e2e": "nextron build --no-pack",
        "pretest:e2e": "node scripts/prepare-e2e-natives.mjs",
        "test:e2e": "npm run build:e2e && playwright test",
        "build:icons": "node resources/build-icons.cjs"
    },
    "overrides": {
        "esbuild": "^0.28.2",
        "@babel/core": "^7.29.6",
        "serialize-javascript": "^7.1.1",
        "webpack": "^5.110.3",
        "sharp": "^0.35.4",
        "postcss": "$postcss",
        "@particle-academy/fancy-slides": {
            "@particle-academy/fancy-code": "$@particle-academy/fancy-code"
        },
        "fast-uri": "^3.1.6",
        "tar": "^7.5.22",
        "brace-expansion@1": "^1.1.18",
        "brace-expansion@2": "^2.1.4",
        "brace-expansion@5": "^5.0.9",
        "@electron/get": {
            "undici": "^7.29.1"
        },
        "node-gyp": {
            "undici": "^6.28.1"
        }
    },
    "dependencies": {
        "@particle-academy/dark-slide": "^0.7.1",
        "@particle-academy/fancy-artboard": "^0.5.0",
        "@particle-academy/fancy-brand-icons": "^0.2.0",
        "@particle-academy/fancy-code": "^0.11.0",
        "@particle-academy/fancy-features": "^0.5.0",
        "@particle-academy/fancy-file-commons": "^0.3.0",
        "@particle-academy/fancy-flow": "^0.69.0",
        "@particle-academy/fancy-git": "^0.3.0",
        "@particle-academy/fancy-git-ui": "^0.5.0",
        "@particle-academy/fancy-sheets": "^0.10.0",
        "@particle-academy/fancy-slides": "^0.16.1",
        "@particle-academy/fancy-term": "^0.5.0",
        "@particle-academy/fancy-term-host": "^0.5.0",
        "@particle-academy/holy-sheet": "^2.2.1",
        "@particle-academy/last-word": "^0.4.0",
        "@particle-academy/react-fancy": "^5.26.0",
        "@types/libsodium-wrappers": "^0.8.2",
        "@types/ws": "^8.18.1",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-serialize": "^0.14.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^13.0.3",
        "echarts-gl": "^2.1.0",
        "electron-updater": "^6.8.9",
        "libsodium-wrappers": "^0.8.4",
        "node-forge": "^1.4.0",
        "node-pty": "^1.1.0",
        "qrcode": "^1.5.4",
        "simple-git": "^3.36.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.5.1",
        "@types/node-forge": "^1.3.14",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.0",
        "autoprefixer": "^10.6.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "next": "^16.3.5",
        "nextron": "^10.3.0",
        "oxc-parser": "^0.149.0",
        "postcss": "^8.5.28",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    }
}
